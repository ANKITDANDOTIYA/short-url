<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShortURL — Link Management & Analytics Platform</title>
    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        slate: {
                            850: '#0f172a',
                            900: '#0B0F19',
                            950: '#07090E',
                        },
                        brand: {
                            500: '#6366F1',
                            600: '#4F46E5',
                            700: '#4338CA',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>

    <!-- React 18 & ReactDOM -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <!-- Babel Standalone -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- QRCode.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #07090E; color: #F8FAFC; }
        
        .subtle-glass {
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.07);
        }
        
        .card-surface {
            background: rgba(17, 24, 39, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        }
        
        .card-surface:hover {
            border-color: rgba(255, 255, 255, 0.15);
        }

        .gradient-headline {
            background: linear-gradient(180deg, #FFFFFF 0%, #94A3B8 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .brand-gradient-text {
            background: linear-gradient(135deg, #818CF8 0%, #C084FC 50%, #38BDF8 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Custom subtle scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #07090E; }
        ::-webkit-scrollbar-thumb { background: #1E293B; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #334155; }
    </style>
</head>
<body>

    <!-- Inject Server EJS Data safely into global scope -->
    <script id="server-data" type="application/json">
        <%- JSON.stringify({
            id: locals.id ? locals.id : null,
            urls: locals.urls ? locals.urls : [],
            user: locals.user ? locals.user : null
        }) %>
    </script>
    <script>
        window.__INITIAL_DATA__ = JSON.parse(document.getElementById('server-data').textContent);
    </script>

    <!-- React App Container -->
    <div id="root"></div>

    <!-- React JSX Application Definition -->
    <script type="text/babel">
        const { useState, useEffect, useMemo } = React;

        // -------------------------------------------------------------
        // Toast Notification Component
        // -------------------------------------------------------------
        function Toast({ message, onClose }) {
            if (!message) return null;
            return (
                <div className="fixed bottom-6 right-6 z-50 flex items-center space-x-3 bg-slate-900 border border-emerald-500/30 text-emerald-400 px-4 py-3 rounded-xl shadow-2xl text-sm font-medium animate-bounce-short">
                    <i data-lucide="check-circle-2" className="w-4 h-4 text-emerald-400"></i>
                    <span>{message}</span>
                </div>
            );
        }

        // -------------------------------------------------------------
        // Sticky Header / Navbar Component
        // -------------------------------------------------------------
        function Navbar({ user }) {
            return (
                <header className="sticky top-0 z-40 w-full subtle-glass border-b border-white/5 transition-all">
                    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                        
                        {/* Logo */}
                        <a href="/" className="flex items-center space-x-2.5 group">
                            <div className="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 via-purple-500 to-cyan-500 p-[1px] shadow-sm shadow-indigo-500/20 group-hover:scale-105 transition-transform duration-200">
                                <div className="w-full h-full bg-slate-950 rounded-[7px] flex items-center justify-center">
                                    <i data-lucide="link-2" className="w-4 h-4 text-indigo-400"></i>
                                </div>
                            </div>
                            <span className="font-bold text-base tracking-tight text-white">
                                Short<span className="text-indigo-400">URL</span>
                            </span>
                        </a>

                        {/* Center Navigation */}
                        <nav className="hidden md:flex items-center space-x-6 text-xs font-medium text-slate-400">
                            <a href="#hero" className="hover:text-white transition-colors">Shorten</a>
                            <a href="#dashboard" className="hover:text-white transition-colors">Analytics</a>
                            <a href="#links" className="hover:text-white transition-colors">Links</a>
                            <a href="https://github.com/ANKITDANDOTIYA/short-url" target="_blank" className="hover:text-white transition-colors flex items-center gap-1">
                                <i data-lucide="github" className="w-3.5 h-3.5"></i>
                                <span>GitHub</span>
                            </a>
                        </nav>

                        {/* User Profile / Auth State */}
                        <div className="flex items-center space-x-3">
                            {user ? (
                                <div className="flex items-center space-x-2.5 bg-white/5 border border-white/10 px-3 py-1.5 rounded-full text-xs text-slate-300">
                                    <span className="w-2 h-2 rounded-full bg-emerald-400"></span>
                                    <span className="font-mono text-slate-200 max-w-[140px] truncate">{user.email}</span>
                                    {user.role === 'ADMIN' && (
                                        <span className="bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 px-1.5 py-0.2 rounded text-[10px] font-bold">ADMIN</span>
                                    )}
                                </div>
                            ) : (
                                <div className="flex items-center space-x-2">
                                    <a href="/login" className="text-xs font-medium text-slate-300 hover:text-white px-3 py-1.5 transition-colors">Log In</a>
                                    <a href="/signup" className="text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500 px-3.5 py-1.5 rounded-lg shadow-sm transition-all">Sign Up</a>
                                </div>
                            )}
                        </div>

                    </div>
                </header>
            );
        }

        // -------------------------------------------------------------
        // Hero Section & Input Form Component
        // -------------------------------------------------------------
        function HeroSection() {
            const [urlInput, setUrlInput] = useState('');
            const [isSubmitting, setIsSubmitting] = useState(false);

            const handleSubmit = (e) => {
                setIsSubmitting(true);
            };

            return (
                <section id="hero" className="pt-8 pb-4 space-y-8 text-center max-w-4xl mx-auto">
                    
                    {/* Pill Tag */}
                    <div className="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-xs font-medium text-indigo-300">
                        <span className="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
                        <span>Next-Gen URL Infrastructure & Real-Time Metrics</span>
                    </div>

                    {/* Title & Subtitle */}
                    <div className="space-y-4">
                        <h1 className="text-4xl sm:text-6xl font-extrabold tracking-tight gradient-headline leading-[1.1]">
                            Short links with <span className="brand-gradient-text">superpower analytics</span>
                        </h1>
                        <p className="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto font-normal">
                            Fast, reliable, and beautiful URL shortener built for creators, marketers, and modern software engineering teams.
                        </p>
                    </div>

                    {/* Prominent Form Container */}
                    <div className="max-w-2xl mx-auto">
                        <div className="card-surface p-2 sm:p-3 rounded-2xl relative shadow-2xl">
                            <form action="/url" method="POST" onSubmit={handleSubmit} className="flex flex-col sm:flex-row gap-2">
                                <div className="relative flex-grow">
                                    <div className="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                                        <i data-lucide="link" className="w-4 h-4"></i>
                                    </div>
                                    <input 
                                        type="url" 
                                        name="url" 
                                        value={urlInput}
                                        onChange={(e) => setUrlInput(e.target.value)}
                                        placeholder="Paste your long URL here (e.g. https://github.com/...)" 
                                        required
                                        className="w-full pl-10 pr-4 py-3 bg-slate-950/80 border border-white/5 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/80 transition-all"
                                    />
                                </div>
                                <button 
                                    type="submit" 
                                    disabled={isSubmitting}
                                    className="py-3 px-6 bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white font-semibold rounded-xl text-sm transition-all duration-150 flex items-center justify-center space-x-2 flex-shrink-0 cursor-pointer shadow-md shadow-indigo-600/20"
                                >
                                    {isSubmitting ? (
                                        <span>Shortening...</span>
                                    ) : (
                                        <>
                                            <span>Shorten URL</span>
                                            <i data-lucide="arrow-right" className="w-4 h-4"></i>
                                        </>
                                    )}
                                </button>
                            </form>
                        </div>
                    </div>

                </section>
            );
        }

        // -------------------------------------------------------------
        // Success Result Card Component
        // -------------------------------------------------------------
        function ResultCard({ id, onCopy, onOpenQR }) {
            if (!id) return null;

            const shortUrl = `http://localhost:8001/${id}`;

            useEffect(() => {
                try {
                    confetti({ particleCount: 70, spread: 60, origin: { y: 0.6 } });
                } catch(e) {}
            }, [id]);

            return (
                <section className="max-w-2xl mx-auto my-6">
                    <div className="card-surface rounded-2xl p-6 border-emerald-500/30 bg-emerald-950/10 relative overflow-hidden">
                        <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                            
                            <div className="space-y-1.5">
                                <div className="inline-flex items-center space-x-1.5 text-xs font-semibold text-emerald-400">
                                    <i data-lucide="check-circle" className="w-4 h-4"></i>
                                    <span>URL Shortened Successfully</span>
                                </div>
                                <div className="text-xl font-bold font-mono text-white tracking-tight">
                                    {shortUrl}
                                </div>
                                <p className="text-xs text-slate-400">Short ID: <code className="text-indigo-300 font-mono">{id}</code></p>
                            </div>

                            <div className="flex items-center space-x-2 w-full sm:w-auto">
                                <button 
                                    onClick={() => onCopy(shortUrl)}
                                    className="flex-1 sm:flex-none px-4 py-2.5 rounded-xl bg-slate-900 border border-white/10 hover:bg-slate-800 text-white font-medium text-xs flex items-center justify-center space-x-1.5 transition-colors cursor-pointer"
                                >
                                    <i data-lucide="copy" className="w-3.5 h-3.5 text-slate-400"></i>
                                    <span>Copy</span>
                                </button>

                                <a 
                                    href={shortUrl} 
                                    target="_blank"
                                    className="flex-1 sm:flex-none px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs flex items-center justify-center space-x-1.5 transition-colors shadow-sm"
                                >
                                    <span>Visit</span>
                                    <i data-lucide="external-link" className="w-3.5 h-3.5"></i>
                                </a>

                                <button 
                                    onClick={() => onOpenQR(shortUrl, id)}
                                    className="px-3 py-2.5 rounded-xl bg-slate-900 border border-white/10 hover:bg-slate-800 text-slate-300 hover:text-white transition-colors cursor-pointer"
                                    title="View QR Code"
                                >
                                    <i data-lucide="qr-code" className="w-3.5 h-3.5"></i>
                                </button>
                            </div>

                        </div>
                    </div>
                </section>
            );
        }

        // -------------------------------------------------------------
        // Dashboard Stats Overview Component
        // -------------------------------------------------------------
        function DashboardStats({ urls }) {
            const totalUrls = urls.length;
            const totalClicks = urls.reduce((acc, curr) => acc + (curr.visitHistory ? curr.visitHistory.length : 0), 0);
            const avgClicks = totalUrls > 0 ? (totalClicks / totalUrls).toFixed(1) : 0;
            const activeLinks = urls.filter(u => u.visitHistory && u.visitHistory.length > 0).length;

            return (
                <section id="dashboard" className="space-y-4">
                    <div className="flex items-center justify-between">
                        <div>
                            <h2 className="text-xl font-bold text-white tracking-tight">Analytics Dashboard</h2>
                            <p className="text-xs text-slate-400">Performance overview across all created short links</p>
                        </div>
                    </div>

                    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        
                        <div className="card-surface p-5 rounded-2xl space-y-3">
                            <div className="flex items-center justify-between text-xs text-slate-400 font-medium">
                                <span>Total Links</span>
                                <i data-lucide="link-2" className="w-4 h-4 text-indigo-400"></i>
                            </div>
                            <div className="text-3xl font-bold font-mono text-white">{totalUrls}</div>
                            <div className="text-[11px] text-slate-500">Active URLs created</div>
                        </div>

                        <div className="card-surface p-5 rounded-2xl space-y-3">
                            <div className="flex items-center justify-between text-xs text-slate-400 font-medium">
                                <span>Total Clicks</span>
                                <i data-lucide="mouse-pointer-click" className="w-4 h-4 text-purple-400"></i>
                            </div>
                            <div className="text-3xl font-bold font-mono text-white">{totalClicks}</div>
                            <div className="text-[11px] text-slate-500">Redirect engagements</div>
                        </div>

                        <div className="card-surface p-5 rounded-2xl space-y-3">
                            <div className="flex items-center justify-between text-xs text-slate-400 font-medium">
                                <span>Avg. Clicks / Link</span>
                                <i data-lucide="bar-chart-2" className="w-4 h-4 text-cyan-400"></i>
                            </div>
                            <div className="text-3xl font-bold font-mono text-white">{avgClicks}</div>
                            <div className="text-[11px] text-slate-500">Engagement ratio</div>
                        </div>

                        <div className="card-surface p-5 rounded-2xl space-y-3">
                            <div className="flex items-center justify-between text-xs text-slate-400 font-medium">
                                <span>Engaged Links</span>
                                <i data-lucide="activity" className="w-4 h-4 text-emerald-400"></i>
                            </div>
                            <div className="text-3xl font-bold font-mono text-emerald-400">{activeLinks}</div>
                            <div className="text-[11px] text-slate-500">Links with &ge; 1 visit</div>
                        </div>

                    </div>
                </section>
            );
        }

        // -------------------------------------------------------------
        // Links Table & List Section Component
        // -------------------------------------------------------------
        function LinksSection({ urls, onCopy, onOpenQR }) {
            const [search, setSearch] = useState('');

            const filteredUrls = useMemo(() => {
                if (!search.trim()) return urls;
                const query = search.toLowerCase();
                return urls.filter(u => 
                    u.shortId.toLowerCase().includes(query) || 
                    (u.redirectUrl && u.redirectUrl.toLowerCase().includes(query))
                );
            }, [urls, search]);

            return (
                <section id="links" className="space-y-4">
                    
                    <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                        <div>
                            <h2 className="text-xl font-bold text-white tracking-tight">Recent Short Links</h2>
                            <p className="text-xs text-slate-400">Manage and inspect your redirect destinations</p>
                        </div>

                        <div className="relative w-full sm:w-64">
                            <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
                                <i data-lucide="search" className="w-3.5 h-3.5"></i>
                            </div>
                            <input 
                                type="text"
                                value={search}
                                onChange={(e) => setSearch(e.target.value)}
                                placeholder="Filter links or short IDs..."
                                className="w-full pl-9 pr-3 py-1.5 bg-slate-950/80 border border-white/10 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
                            />
                        </div>
                    </div>

                    <div className="card-surface rounded-2xl overflow-hidden">
                        {filteredUrls.length > 0 ? (
                            <div className="divide-y divide-white/5">
                                {filteredUrls.map((url, idx) => {
                                    const shortUrl = `http://localhost:8001/${url.shortId}`;
                                    const clicks = url.visitHistory ? url.visitHistory.length : 0;
                                    
                                    return (
                                        <div key={url.shortId || idx} className="p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 hover:bg-white/[0.02] transition-colors">
                                            
                                            <div className="space-y-1 max-w-xl">
                                                <div className="flex items-center space-x-2">
                                                    <code className="px-2 py-0.5 bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs font-mono font-semibold rounded">
                                                        /{url.shortId}
                                                    </code>
                                                    <a 
                                                        href={shortUrl} 
                                                        target="_blank" 
                                                        className="text-xs font-mono text-indigo-400 hover:underline flex items-center gap-1"
                                                    >
                                                        <span>{shortUrl}</span>
                                                        <i data-lucide="external-link" className="w-3 h-3"></i>
                                                    </a>
                                                </div>
                                                <p className="text-xs text-slate-400 truncate max-w-md" title={url.redirectUrl}>
                                                    {url.redirectUrl}
                                                </p>
                                            </div>

                                            <div className="flex items-center space-x-4 w-full sm:w-auto justify-between sm:justify-end">
                                                
                                                <div className="flex items-center space-x-1 bg-white/5 px-2.5 py-1 rounded-lg border border-white/5 text-xs text-slate-300">
                                                    <i data-lucide="mouse-pointer-click" className="w-3 h-3 text-purple-400"></i>
                                                    <span className="font-mono font-semibold">{clicks}</span>
                                                    <span className="text-[10px] text-slate-500">clicks</span>
                                                </div>

                                                <div className="flex items-center space-x-1.5">
                                                    <button 
                                                        onClick={() => onCopy(shortUrl)}
                                                        className="p-2 rounded-lg bg-slate-900 border border-white/10 hover:bg-slate-800 text-slate-300 hover:text-white transition-colors cursor-pointer"
                                                        title="Copy Link"
                                                    >
                                                        <i data-lucide="copy" className="w-3.5 h-3.5"></i>
                                                    </button>
                                                    <button 
                                                        onClick={() => onOpenQR(shortUrl, url.shortId)}
                                                        className="p-2 rounded-lg bg-slate-900 border border-white/10 hover:bg-slate-800 text-slate-300 hover:text-white transition-colors cursor-pointer"
                                                        title="QR Code"
                                                    >
                                                        <i data-lucide="qr-code" className="w-3.5 h-3.5"></i>
                                                    </button>
                                                </div>

                                            </div>

                                        </div>
                                    );
                                })}
                            </div>
                        ) : (
                            <div className="py-16 text-center space-y-4">
                                <div className="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center mx-auto text-slate-500">
                                    <i data-lucide="link-2-off" className="w-6 h-6"></i>
                                </div>
                                <div className="space-y-1">
                                    <h3 className="text-sm font-semibold text-white">No URLs found</h3>
                                    <p className="text-xs text-slate-500">Create your first short URL using the input above</p>
                                </div>
                            </div>
                        )}
                    </div>

                </section>
            );
        }

        // -------------------------------------------------------------
        // QR Code Modal Component
        // -------------------------------------------------------------
        function QrModal({ isOpen, url, title, onClose, onCopy }) {
            if (!isOpen) return null;

            useEffect(() => {
                const container = document.getElementById('modal-qrcode');
                if (container) {
                    container.innerHTML = '';
                    new QRCode(container, {
                        text: url,
                        width: 180,
                        height: 180,
                        colorDark: '#07090E',
                        colorLight: '#ffffff',
                        correctLevel: QRCode.CorrectLevel.H
                    });
                }
            }, [url]);

            return (
                <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm animate-fade-in">
                    <div className="card-surface rounded-2xl p-6 max-w-sm w-full relative space-y-5 text-center">
                        <button 
                            onClick={onClose}
                            className="absolute top-4 right-4 text-slate-400 hover:text-white transition-colors"
                        >
                            <i data-lucide="x" className="w-4 h-4"></i>
                        </button>

                        <div className="space-y-1">
                            <h3 className="text-base font-bold text-white">QR Code</h3>
                            <p className="text-xs text-slate-400 font-mono">Short ID: {title}</p>
                        </div>

                        <div className="p-3 bg-white rounded-xl inline-block mx-auto shadow-md">
                            <div id="modal-qrcode"></div>
                        </div>

                        <div className="space-y-2">
                            <code className="block text-[11px] font-mono text-indigo-300 truncate bg-slate-950 p-2 rounded-lg border border-white/5">
                                {url}
                            </code>
                            <button 
                                onClick={() => { onCopy(url); onClose(); }}
                                className="w-full py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs rounded-xl transition-all cursor-pointer"
                            >
                                Copy Link URL
                            </button>
                        </div>
                    </div>
                </div>
            );
        }

        // -------------------------------------------------------------
        // Main React Application Wrapper
        // -------------------------------------------------------------
        function App() {
            const data = window.__INITIAL_DATA__ || {};
            const [toastMessage, setToastMessage] = useState('');
            const [qrState, setQrState] = useState({ open: false, url: '', title: '' });

            useEffect(() => {
                if (window.lucide) {
                    window.lucide.createIcons();
                }
            }, []);

            const triggerToast = (msg) => {
                setToastMessage(msg);
                setTimeout(() => setToastMessage(''), 3000);
            };

            const handleCopy = (text) => {
                navigator.clipboard.writeText(text).then(() => {
                    triggerToast('Copied to clipboard!');
                });
            };

            const handleOpenQR = (url, title) => {
                setQrState({ open: true, url, title });
            };

            return (
                <div className="min-h-screen flex flex-col justify-between">
                    <Navbar user={data.user} />
                    
                    <main className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12 flex-grow">
                        <HeroSection />
                        
                        <ResultCard 
                            id={data.id} 
                            onCopy={handleCopy} 
                            onOpenQR={handleOpenQR} 
                        />
                        
                        <DashboardStats urls={data.urls} />
                        
                        <LinksSection 
                            urls={data.urls} 
                            onCopy={handleCopy} 
                            onOpenQR={handleOpenQR} 
                        />
                    </main>

                    <footer className="w-full border-t border-white/5 py-8 text-center text-xs text-slate-500">
                        &copy; {new Date().getFullYear()} ShortURL Platform. Built with React & Tailwind CSS.
                    </footer>

                    <QrModal 
                        isOpen={qrState.open} 
                        url={qrState.url} 
                        title={qrState.title} 
                        onClose={() => setQrState({ open: false, url: '', title: '' })} 
                        onCopy={handleCopy}
                    />

                    <Toast message={toastMessage} onClose={() => setToastMessage('')} />
                </div>
            );
        }

        // Render React 18 Application
        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>

