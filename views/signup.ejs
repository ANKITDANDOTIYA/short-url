<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account — ShortURL Platform</title>
    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        slate: {
                            850: '#0f172a',
                            900: '#0B0F19',
                            950: '#07090E',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>

    <!-- React 18 & ReactDOM -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <!-- Babel Standalone -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #07090E; color: #F8FAFC; }
        
        .subtle-glass {
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.07);
        }
        
        .card-surface {
            background: rgba(17, 24, 39, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <script id="server-data" type="application/json">
        <%- JSON.stringify({
            error: locals.error ? locals.error : null
        }) %>
    </script>
    <script>
        window.__INITIAL_DATA__ = JSON.parse(document.getElementById('server-data').textContent);
    </script>

    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect } = React;

        function SignupForm() {
            const data = window.__INITIAL_DATA__ || {};
            const [name, setName] = useState('');
            const [email, setEmail] = useState('');
            const [password, setPassword] = useState('');

            useEffect(() => {
                if (window.lucide) window.lucide.createIcons();
            }, []);

            return (
                <div className="min-h-screen flex flex-col justify-between">
                    
                    <header className="w-full subtle-glass border-b border-white/5 py-4 px-6 flex items-center justify-between">
                        <a href="/" className="flex items-center space-x-2 group">
                            <div className="w-7 h-7 rounded-lg bg-indigo-600 p-[1px] flex items-center justify-center">
                                <i data-lucide="link-2" className="w-4 h-4 text-white"></i>
                            </div>
                            <span className="font-bold text-sm text-white">Short<span className="text-indigo-400">URL</span></span>
                        </a>
                        <a href="/login" className="text-xs font-medium text-slate-400 hover:text-white transition-colors">
                            Already have an account? <span className="text-indigo-400 font-semibold ml-1">Log in &rarr;</span>
                        </a>
                    </header>

                    <main className="flex-grow flex items-center justify-center p-4">
                        <div className="w-full max-w-md">
                            <div className="card-surface p-8 rounded-2xl space-y-6">
                                
                                <div className="space-y-1.5 text-center">
                                    <h1 className="text-2xl font-bold text-white tracking-tight">Create an Account</h1>
                                    <p className="text-xs text-slate-400">Get started with fast short links and engagement metrics</p>
                                </div>

                                {data.error && (
                                    <div className="p-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-xs flex items-center space-x-2">
                                        <i data-lucide="alert-circle" className="w-4 h-4 flex-shrink-0"></i>
                                        <span>{data.error}</span>
                                    </div>
                                )}

                                <form action="/user" method="POST" className="space-y-4">
                                    <div className="space-y-1.5">
                                        <label className="block text-xs font-semibold text-slate-300">Full Name</label>
                                        <div className="relative">
                                            <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
                                                <i data-lucide="user" className="w-4 h-4"></i>
                                            </div>
                                            <input 
                                                type="text"
                                                name="name"
                                                value={name}
                                                onChange={(e) => setName(e.target.value)}
                                                placeholder="John Doe"
                                                required
                                                className="w-full pl-9 pr-3 py-2.5 bg-slate-950/80 border border-white/10 rounded-xl text-white placeholder-slate-500 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500"
                                            />
                                        </div>
                                    </div>

                                    <div className="space-y-1.5">
                                        <label className="block text-xs font-semibold text-slate-300">Email Address</label>
                                        <div className="relative">
                                            <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
                                                <i data-lucide="mail" className="w-4 h-4"></i>
                                            </div>
                                            <input 
                                                type="email"
                                                name="email"
                                                value={email}
                                                onChange={(e) => setEmail(e.target.value)}
                                                placeholder="you@company.com"
                                                required
                                                className="w-full pl-9 pr-3 py-2.5 bg-slate-950/80 border border-white/10 rounded-xl text-white placeholder-slate-500 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500"
                                            />
                                        </div>
                                    </div>

                                    <div className="space-y-1.5">
                                        <label className="block text-xs font-semibold text-slate-300">Password</label>
                                        <div className="relative">
                                            <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
                                                <i data-lucide="lock" className="w-4 h-4"></i>
                                            </div>
                                            <input 
                                                type="password"
                                                name="password"
                                                value={password}
                                                onChange={(e) => setPassword(e.target.value)}
                                                placeholder="••••••••"
                                                required
                                                className="w-full pl-9 pr-3 py-2.5 bg-slate-950/80 border border-white/10 rounded-xl text-white placeholder-slate-500 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500"
                                            />
                                        </div>
                                    </div>

                                    <button 
                                        type="submit"
                                        className="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs rounded-xl transition-all cursor-pointer shadow-md shadow-indigo-600/20"
                                    >
                                        Create Free Account
                                    </button>
                                </form>

                            </div>
                        </div>
                    </main>

                    <footer className="py-6 text-center text-xs text-slate-500 border-t border-white/5">
                        &copy; {new Date().getFullYear()} ShortURL Platform. All rights reserved.
                    </footer>

                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<SignupForm />);
    </script>
</body>
</html>
